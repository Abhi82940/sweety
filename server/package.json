{
  "name": "sweety-server",
  "version": "1.0.0",
  "description": "Backend API for Sweety - Blood Glucose Tracking and Reporting System",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init:db": "node scripts/init-db.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "seed": "node ../database/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "puppeteer-core": "^25.16.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000
  }
}
